#: wpfonts.php
msgid ""
"Add privacy-friendly system font stacks for Chinese, English, Japanese, and "
"Korean to the WordPress Font Library."
msgstr "向 WordPress 字体库添加注重隐私的中文、英文、日文和韩文系统字体栈。"

