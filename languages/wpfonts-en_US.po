msgstr "Health check"

#: includes/class-wpfonts-admin.php:610
msgid "在服务器上向文风验证。页面上不会显示 Key。"
msgstr "Verifies with Windfonts from the server. The Key is never shown on the page."

#: includes/class-wpfonts-admin.php:611
msgid "请求"
msgstr "Request"

#: includes/class-wpfonts-admin.php:613
msgid "验证请求发往 app.windfonts.com，不走字体 CDN。"
msgstr "The check request goes to app.windfonts.com, not the font CDN."

