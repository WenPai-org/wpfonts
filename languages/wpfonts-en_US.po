msgstr "The file contains a secret; import was refused. Secrets are never written to this site."

#: includes/class-wpfonts-admin.php:1023
msgid "这份文件不能导入。请使用本页导出的 JSON。"
msgstr "This file cannot be imported. Use the JSON exported from this page."

#: includes/class-wpfonts-admin.php:1025
