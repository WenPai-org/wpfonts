msgstr "I confirm this file should update enabled font packages and replace the confirmed Windfonts Cloud list."

#: includes/class-wpfonts-admin.php:1059
msgid "未勾选不能点。密钥不会写入。"
msgstr "Nothing can be submitted until checked. Secrets are never written."

#: includes/class-wpfonts-admin.php:1060
msgid "导入 JSON"
msgstr "Import JSON"

#: includes/class-wpfonts-admin.php:1077
